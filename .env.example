# App
NEXT_PUBLIC_APP_URL=https://marketplace.eventyvo.com

# Cron (Vercel)
CRON_SECRET=change-me-cron

# Partner sync (eventyvo-b2b Integrations page pull)
B2B_MARKETPLACE_SYNC_SECRET=change-me-marketplace

# Optional push to B2B webhook after checkout
# EVENTYVO_B2B_MARKETPLACE_WEBHOOK_URL=https://b2b.eventyvo.com/api/webhooks/marketplace
# B2B_MARKETPLACE_WEBHOOK_SECRET=change-me-marketplace-wh

# Server-side order store path (default .data/marketplace-orders.json)
# MARKETPLACE_ORDERS_STORE_PATH=

# Fennec order webhook
# FENNEC_MARKETPLACE_ORDER_WEBHOOK_URL=
# FENNEC_MARKETPLACE_WEBHOOK_SECRET=
